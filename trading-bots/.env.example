# Copy this file to .env and fill in your Alpaca PAPER trading keys.
# Get them at https://app.alpaca.markets -> switch to Paper Trading -> API Keys.
# Never commit .env or share these keys.

ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# true = paper trading (fake money). Only change to false when you deliberately
# want real money, with live keys.
ALPACA_PAPER=true
